    # ========================================================
    # SERIAL THREAD
    # ========================================================

    def serial_reader(self):
        time.sleep(2.0)

        try:
            self.serial_connection.reset_input_buffer()
        except Exception:
            pass

        while not self.stop_event.is_set():
            try:
                line = self.serial_connection.readline()

                if not line:
                    continue

                decoded = line.decode("utf-8", errors="ignore").strip()

                if decoded:
                    elapsed = time.time() - self.start_time
                    self.line_queue.put((decoded, elapsed))

            except Exception:
                if not self.stop_event.is_set():
                    self.line_queue.put(("__SERIAL_ERROR__", 0.0))
                break

    # ========================================================
    # SERIAL PARSER
    # ========================================================

    def process_serial_queue(self):
        processed = 0

        while processed < 3000:
            try:
                line, elapsed = self.line_queue.get_nowait()
            except queue.Empty:
                break

            if line == "__SERIAL_ERROR__":
                if self.control_window is not None:
                    self.connection_var.set("Серийната връзка е прекъсната")
                break

            self.handle_serial_line(line, elapsed)
            processed += 1

        if not self.stop_event.is_set():
            self.root.after(10, self.process_serial_queue)

    def smooth_time(self, buffer, elapsed):
        """
        Семплите идват на равни интервали (50 Hz), но USB ги доставя
        на групи. Поддържаме собствен часовник, който следва времето
        на получаване бавно - така пиковете не "треперят" във времето.
        """
        clock = buffer["clock"]

        if clock is None or abs(elapsed - clock) > 0.5:
            clock = elapsed
        else:
            clock += 1.0 / RAW_SAMPLE_RATE
            clock += CLOCK_GAIN * (elapsed - clock)

        buffer["clock"] = clock
        return clock

    def handle_serial_line(self, line, elapsed):
        """
        Очаквани Arduino редове:

        pulseN_raw:512      (50 Hz)  <- ползва се
        pulseN_rr / _bpm             <- игнорират се (IBI/BPM се смятат тук)
        nir:12345
        """

        if not line or ":" not in line:
            return

        prefix, value_text = line.split(":", 1)
        prefix = prefix.strip().lower()

        try:
            value = float(value_text.strip())
        except ValueError:
            return

        if prefix == "nir":
            nir_time.append(elapsed)
            nir_data.append(value)

            if self.save_enabled:
                nir_log.append((round(elapsed, 3), value))

            return

        parts = prefix.split("_")

        if len(parts) != 2:
            return

        sensor_name, signal_name = parts

        if sensor_name not in pulse_buffers or signal_name != "raw":
            return

        buffer = pulse_buffers[sensor_name]
        sample_time = self.smooth_time(buffer, elapsed)

        if self.save_enabled:
            buffer["log_raw"].append(
                (round(sample_time, 3), int(round(value)))
            )

        if value < RAW_DROP_THRESHOLD:
            if buffer["last_good_raw"] is None:
                return
            value = buffer["last_good_raw"]
        else:
            buffer["last_good_raw"] = value

        buffer["raw_time"].append(sample_time)
        buffer["raw_data"].append(value)

        # средно RAW от началото
        buffer["raw_sum"] += value
        buffer["raw_count"] += 1

        result = buffer["detector"].update(value, sample_time)

        if result is not None:
            peak_time, ibi, bpm = result

            buffer["ibi_time"].append(peak_time)
            buffer["ibi_data"].append(ibi)
            buffer["bpm_time"].append(peak_time)
            buffer["bpm_data"].append(bpm)

            # средно IBI / BPM от началото
            buffer["ibi_sum"] += ibi
            buffer["ibi_count"] += 1
            buffer["bpm_sum"] += bpm
            buffer["bpm_count"] += 1

            if self.save_enabled:
                buffer["log_beats"].append(
                    (round(peak_time, 3), round(ibi, 1), round(bpm, 1))
                )

    # ========================================================
    # ЗАПИС НА ДАННИТЕ (EXCEL / CSV) - ВСИЧКО В ЕДИН ЛИСТ
    # ========================================================

    def build_tables(self):
        tables = []

        for index, sensor_name in enumerate(
            ("pulse1", "pulse2", "pulse3"), start=1
        ):
            buffer = pulse_buffers[sensor_name]

            tables.append((
                f"Pulse {index} Raw",
                ["Time_s", "Raw"],
                list(buffer["log_raw"])
            ))

            tables.append((
                f"Pulse {index} Beats",
                ["Time_s", "IBI_ms", "BPM"],
                list(buffer["log_beats"])
            ))

        tables.append((
            "AS7341 NIR",
            ["Time_s", "NIR"],
            list(nir_log)
        ))

        return tables

    def build_combined_rows(self, tables):
        """
        Слепва всички таблици в един лист - една до друга,
        с празна колона между тях.
        Ред 1 = име на блока, ред 2 = заглавия на колоните.
        """
        title_row = []
        header_row = []

        for i, (title, headers, rows) in enumerate(tables):
            if i > 0:
                title_row.append(None)
                header_row.append(None)

            title_row.append(title)
            title_row.extend([None] * (len(headers) - 1))
            header_row.extend(headers)

        max_rows = max((len(rows) for _, _, rows in tables), default=0)
        body = []

        for r in range(max_rows):
            line = []

            for i, (title, headers, rows) in enumerate(tables):
                if i > 0:
                    line.append(None)

                if r < len(rows):
                    line.extend(rows[r])
                else:
                    line.extend([None] * len(headers))

            body.append(line)

        return [title_row, header_row] + body

    def save_data(self):
        """Връща (успех, път_или_грешка)."""
        if not self.save_enabled:
            return True, ""

        try:
            os.makedirs(self.save_folder, exist_ok=True)

            tables = self.build_tables()
            all_rows = self.build_combined_rows(tables)
            base_name = f"Multi_Sensor_{self.session_stamp}"

            if self.excel_available:
                from openpyxl import Workbook

                workbook = Workbook(write_only=True)
                sheet = workbook.create_sheet(title="Data")
                sheet.freeze_panes = "A3"      # заглавията остават видими

                for row in all_rows:
                    sheet.append(row)

                path = os.path.join(self.save_folder, base_name + ".xlsx")
                workbook.save(path)

            else:
                path = os.path.join(self.save_folder, base_name + ".csv")

                with open(path, "w", newline="", encoding="utf-8") as csv_file:
                    csv.writer(csv_file).writerows(all_rows)

            return True, path

        except Exception as error:
            return False, str(error)

    def save_now(self):
        ok, info = self.save_data()

        if ok:
            messagebox.showinfo(
                "Данните са запазени",
