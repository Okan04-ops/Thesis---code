def get_available_ports():
    try:
        ports = [port.device for port in list_ports.comports()]
    except Exception:
        ports = []

    if not ports:
        ports = [f"COM{i}" for i in range(3, 16)]

    return sorted(ports)


def get_window_limits(now, seconds):
    if now < seconds:
        return 0.0, seconds

    return now - seconds, now


def latest_point(times, values, view_now):
    """Последната точка с време <= view_now, или (None, None)."""
    for i in range(len(times) - 1, -1, -1):
        if times[i] <= view_now:
            return times[i], values[i]

    return None, None


def autoscale_y(axis, values, min_span, pad=0.15):
    """Мащабира Y оста към видимите данни, така че вълните да се виждат."""
    data = np.asarray(values, dtype=float)
    data = data[np.isfinite(data)]

    if len(data) == 0:
        return

    low = float(data.min())
    high = float(data.max())

    span = max(high - low, min_span)
    center = (high + low) / 2.0
    half = span * (0.5 + pad)

    axis.set_ylim(center - half, center + half)


def excel_is_available():
    try:
        import openpyxl  # noqa: F401
        return True
    except ImportError:
        return False


