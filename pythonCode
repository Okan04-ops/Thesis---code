class PulseDetector:
    """
    1. Лентов филтър: изглаждане (~4 Hz) минус бавна базова линия (~0.4 Hz).
    2. Адаптивен праг = 50% от скорошната амплитуда (не под MIN_AMPLITUDE).
    3. Пик = локален максимум над прага.
    4. Всеки валиден удар дава IBI. Липсващ удар (интервал ~2x по-дълъг)
       се записва като един нормален интервал, а излишни пикове се пропускат,
       така че серията не се къса.
    5. BPM = 60000 / медиана на последните интервали.
    """

    def __init__(self, fs):
        self.fs = float(fs)
        self.a_lp = 1.0 - math.exp(-2.0 * math.pi * 4.0 / self.fs)
        self.a_base = 1.0 - math.exp(-2.0 * math.pi * 0.4 / self.fs)
        self.env_decay = 0.78 ** (1.0 / self.fs)
        self.reset()

    def reset(self):
        self.lp1 = None
        self.lp2 = None
        self.base = None
        self.env = 0.0
        self.prev2 = 0.0
        self.prev1 = 0.0
        self.prev1_t = 0.0
        self.samples = 0
        self.blocked_until = 0.0
        self.last_peak_t = None
        self.ibis = deque(maxlen=8)
        self.rejects = 0

    def update(self, x, t):
        """Връща None или (време_на_пика, ibi_ms, bpm)."""
        if self.lp1 is None:
            self.lp1 = self.lp2 = self.base = float(x)

        self.lp1 += self.a_lp * (x - self.lp1)
        self.lp2 += self.a_lp * (self.lp1 - self.lp2)
        self.base += self.a_base * (x - self.base)

        ac = self.lp2 - self.base
        self.samples += 1

        # Движение / насищане: кратко игнориране, историята на ритъма се пази
        if x >= SATURATION_LEVEL or abs(ac) > ARTIFACT_LIMIT:
            self.blocked_until = t + ARTIFACT_BLOCK_S
            self.env = 0.0
            self.last_peak_t = None

        positive = min(max(ac, 0.0), ARTIFACT_LIMIT)
        self.env = max(positive, self.env * self.env_decay)
        threshold = max(0.5 * self.env, MIN_AMPLITUDE)

        result = None

        if (
            t >= self.blocked_until
            and self.samples > self.fs * SETTLE_S
            and self.prev1 > threshold
            and self.prev1 >= self.prev2
            and self.prev1 > ac
        ):
            result = self.register_peak(self.prev1_t)

        self.prev2 = self.prev1
        self.prev1 = ac
        self.prev1_t = t

        return result

    def register_peak(self, peak_t):
        if self.last_peak_t is None:
            self.last_peak_t = peak_t
            return None

        ibi = (peak_t - self.last_peak_t) * 1000.0

        # Твърде рано (шум / дикротичен пик) - пропускаме пика
        if ibi < MIN_IBI_MS:
            return None

        if len(self.ibis) >= 3:
            median = float(np.median(self.ibis))

            if ibi < 0.65 * median:
                return None

            if ibi > 1.5 * median:
                k = int(round(ibi / median))

                if 2 <= k <= 4 and abs(ibi / k - median) < 0.25 * median:
                    ibi = ibi / k          # пропуснат удар -> един интервал
                else:
                    self.rejects += 1
                    self.last_peak_t = peak_t

                    if self.rejects >= 3:  # вероятно нов ритъм
                        self.ibis.clear()
                        self.rejects = 0

                    return None

        if ibi > MAX_IBI_MS:
            self.last_peak_t = peak_t
            return None

        self.rejects = 0
        self.ibis.append(ibi)
        self.last_peak_t = peak_t

        return peak_t, ibi, self.current_bpm()

    def current_bpm(self):
        recent = list(self.ibis)[-5:]
        return 60000.0 / float(np.median(recent))


