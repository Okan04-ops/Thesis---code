    def style_axis(self, axis):
        axis.set_facecolor(PLOT_BG)
        axis.tick_params(colors=TEXT, labelsize=8)

        for spine in axis.spines.values():
            spine.set_color(BORDER)

        axis.xaxis.label.set_color(TEXT)
        axis.yaxis.label.set_color(TEXT)
        axis.title.set_color(TEXT)

        axis.grid(True, color=BORDER, alpha=0.35, linewidth=0.7)

    def draw_series(
        self, axis, times, values, min_time, view_now,
        color, label, min_span, markers=True, extend=True
    ):
        """
        Рисува непрекъсната линия във видимия прозорец и мащабира Y оста
        към данните. Паузите между удари не се прекъсват, а последната
        стойност се продължава с пунктир до текущото време.
        """
        if len(times) == 0:
            return False

        t = np.asarray(times, dtype=float)
        y = np.asarray(values, dtype=float)

        mask = (t >= min_time) & (t <= view_now)
        t = t[mask]
        y = y[mask]

        if len(t) == 0:
            return False

        autoscale_y(axis, y, min_span)

        axis.plot(
            t, y,
            color=color, linewidth=1.6,
            marker="o" if markers else None,
            markersize=3, label=label
        )

        if extend and t[-1] < view_now:
            axis.plot(
                [t[-1], view_now], [y[-1], y[-1]],
                color=color, linewidth=1.0, linestyle=":"
            )

        legend = axis.legend(
            loc="upper right", fontsize=8,
            facecolor=PANEL_LIGHT, edgecolor=BORDER
        )

        for legend_text in legend.get_texts():
            legend_text.set_color(TEXT)

        return True

    def draw_waiting_text(self, axis, text):
        axis.text(
            0.5, 0.5, text,
            transform=axis.transAxes,
            ha="center", va="center", color=MUTED, fontsize=10
        )

    # ========================================================
    # ОБНОВЯВАНЕ НА PULSE ПРОЗОРЕЦ
    # ========================================================

    def update_pulse_window(self, sensor_name, view_now):
        if sensor_name not in self.pulse_windows:
            return

        ui = self.pulse_windows[sensor_name]
        buffer = pulse_buffers[sensor_name]

        ibi_axis = ui["ibi_axis"]
        bpm_axis = ui["bpm_axis"]
        accent_color = ui["accent_color"]

        min_time, max_time = get_window_limits(view_now, WINDOW_SECONDS)

        # ---------------- IBI графика ----------------

        ibi_axis.clear()
        self.style_axis(ibi_axis)
        ibi_axis.set_xlim(min_time, max_time)
        ibi_axis.set_ylim(400, 1200)
        ibi_axis.set_title(
            "IBI - интервал между удари",
            loc="left", fontsize=10, fontweight="bold"
        )
        ibi_axis.set_ylabel("IBI (ms)")

        has_ibi = self.draw_series(
            ibi_axis, buffer["ibi_time"], buffer["ibi_data"],
            min_time, view_now, accent_color, "IBI", MIN_SPAN_IBI
        )

        if not has_ibi:
            self.draw_waiting_text(
                ibi_axis, "Очакват се удари - поставете пръст върху сензора"
            )

        # ---------------- BPM графика ----------------

        bpm_axis.clear()
        self.style_axis(bpm_axis)
        bpm_axis.set_xlim(min_time, max_time)
        bpm_axis.set_ylim(40, 180)
        bpm_axis.set_title(
            "BPM (изчислен в Python)",
            loc="left", fontsize=10, fontweight="bold"
        )
        bpm_axis.set_xlabel("Време (s)")
        bpm_axis.set_ylabel("BPM")

        self.draw_series(
            bpm_axis, buffer["bpm_time"], buffer["bpm_data"],
            min_time, view_now, accent_color, "BPM", MIN_SPAN_BPM
        )

        # ---------------- Показатели (средно от началото) ----------------

        if buffer["bpm_count"] > 0:
            ui["bpm_var"].set(
                f"{buffer['bpm_sum'] / buffer['bpm_count']:.0f}"
            )
        else:
            ui["bpm_var"].set("--")

        if buffer["ibi_count"] > 0:
            ui["ibi_var"].set(
                f"{buffer['ibi_sum'] / buffer['ibi_count']:.0f}"
            )
        else:
            ui["ibi_var"].set("--")

        if buffer["raw_count"] > 0:
            ui["raw_var"].set(
                f"{buffer['raw_sum'] / buffer['raw_count']:.0f}"
            )
        else:
            ui["raw_var"].set("--")

        ui["canvas"].draw_idle()

    # ========================================================
    # ОБНОВЯВАНЕ НА NIR ПРОЗОРЕЦ
    # ========================================================

    def update_nir_window(self, view_now):
        self.nir_axis.clear()
        self.style_axis(self.nir_axis)

        min_time, max_time = get_window_limits(view_now, WINDOW_SECONDS)

        self.nir_axis.set_xlim(min_time, max_time)
        self.nir_axis.set_title(
            "AS7341 NIR спектрален канал",
            loc="left", fontsize=11, fontweight="bold"
        )
        self.nir_axis.set_xlabel("Време (s)")
        self.nir_axis.set_ylabel("NIR intensity")

        has_data = self.draw_series(
            self.nir_axis, nir_time, nir_data,
            min_time, view_now, CYAN, "NIR", MIN_SPAN_NIR,
            markers=False, extend=False
        )

        if not has_data:
            self.draw_waiting_text(
                self.nir_axis,
                "Очакват се данни от AS7341\nArduino формат: nir:стойност"
            )

        _, nir_value = latest_point(nir_time, nir_data, view_now)
        self.nir_value_var.set(
            f"{nir_value:.0f}" if nir_value is not None else "--"
        )

        self.nir_canvas.draw_idle()

    # ========================================================
    # ГЛАВНО GUI ОБНОВЯВАНЕ
    # ========================================================

    def update_gui(self):
        if self.stop_event.is_set():
            return

        now = time.time() - self.start_time
        view_now = now - DISPLAY_DELAY_S

        self.update_pulse_window("pulse1", view_now)
        self.update_pulse_window("pulse2", view_now)
        self.update_pulse_window("pulse3", view_now)
        self.update_nir_window(view_now)

        self.root.after(int(1000 / PLOT_FPS), self.update_gui)

    # ========================================================
    # ЗАТВАРЯНЕ НА ПРОГРАМАТА (със запис на данните)
    # ========================================================

    def close_application(self):
        if self.closing:
            return

        self.closing = True
        self.stop_event.set()

        if self.serial_connection is not None:
            try:
                self.serial_connection.close()
            except Exception:
                pass

        if self.reader_thread is not None:
            try:
                self.reader_thread.join(timeout=0.5)
            except Exception:
                pass

        if self.save_enabled:
            ok, info = self.save_data()

            try:
                if ok:
                    messagebox.showinfo(
                        "Данните са запазени",
                        f"Записано в:\n{info}"
                    )
                else:
                    messagebox.showerror(
                        "Грешка при запис",
                        (
                            f"Данните не бяха запазени.\n\n{info}\n\n"
                            "Ако файлът е отворен в Excel, затворете го."
                        )
                    )
            except Exception:
                pass

        try:
            self.root.destroy()
        except Exception:
            pass


