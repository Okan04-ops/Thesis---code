    def toggle_save_options(self):
        state = "normal" if self.save_var.get() else "disabled"
        self.folder_entry.configure(state=state)
        self.folder_button.configure(state=state)

    def browse_folder(self):
        start = self.folder_var.get().strip()

        if not start or not os.path.isdir(start):
            start = os.path.expanduser("~")

        folder = filedialog.askdirectory(
            parent=self.setup,
            initialdir=start,
            title="Изберете папка за запис на данните"
        )

        if folder:
            self.folder_var.set(os.path.normpath(folder))

    def refresh_ports(self):
        ports = get_available_ports()
        current_port = self.port_var.get()

        if current_port not in ports:
            ports.insert(0, current_port)

        self.port_combo["values"] = ports

    # ========================================================
    # СВЪРЗВАНЕ КЪМ ARDUINO
    # ========================================================

    def connect(self):
        port = self.port_var.get()

        try:
            baud = int(self.baud_var.get())
        except ValueError:
            messagebox.showerror(
                "Невалиден baud rate",
                "Изберете валидна serial скорост.",
                parent=self.setup
            )
            return

        # ---- проверка на настройките за запис ----

        save_enabled = bool(self.save_var.get())
        save_folder = ""
        excel_available = False

        if save_enabled:
            save_folder = self.folder_var.get().strip()

            if not save_folder:
                messagebox.showerror(
                    "Липсва папка",
                    "Изберете папка, в която да се запишат данните.",
                    parent=self.setup
                )
                return

            try:
                os.makedirs(save_folder, exist_ok=True)
            except Exception as error:
                messagebox.showerror(
                    "Папката не може да се използва",
                    f"{save_folder}\n\n{error}",
                    parent=self.setup
                )
                return

            excel_available = excel_is_available()

            if not excel_available:
                use_csv = messagebox.askyesno(
                    "Липсва библиотеката openpyxl",
                    (
                        "За запис в .xlsx е нужна библиотеката openpyxl:\n\n"
                        "    pip install openpyxl\n\n"
                        "Да продължа ли със запис в CSV файл "
                        "(отваря се в Excel)?"
                    ),
                    parent=self.setup
                )

                if not use_csv:
                    return

        # ---- отваряне на serial порта ----

        try:
            self.serial_connection = serial.Serial(
                port=port, baudrate=baud, timeout=0.1
            )
        except Exception as error:
            messagebox.showerror(
                "Грешка при свързване",
                f"Не може да се отвори {port}.\n\n{error}",
                parent=self.setup
            )
            return

        self.save_enabled = save_enabled
        self.save_folder = save_folder
        self.excel_available = excel_available
        self.session_stamp = datetime.now().strftime("%Y-%m-%d_%H-%M-%S")
        self.control_height = 330 if save_enabled else 240

        self.start_time = time.time()

        self.setup.destroy()

        self.create_control_window(port, baud)

        self.create_pulse_window("pulse1", "Pulse Sensor 1", BLUE)
        self.create_pulse_window("pulse2", "Pulse Sensor 2", PURPLE)
        self.create_pulse_window("pulse3", "Pulse Sensor 3", ORANGE)

        self.create_nir_window()

        self.root.after(250, self.arrange_sensor_windows)

        self.stop_event.clear()

        self.reader_thread = threading.Thread(
            target=self.serial_reader, daemon=True
        )
        self.reader_thread.start()

        self.root.after(10, self.process_serial_queue)
        self.root.after(100, self.update_gui)

